{
	"name": "checklist-status-icons",
	"version": "0.1.1",
	"description": "Apply Status Sets' reusable status sets to checklist items inside your notes — per file, block, or heading.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tasks",
		"checklist",
		"status"
	],
	"author": "Dan Fletcher",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.28.4",
		"@types/node": "^20.14.9",
		"@typescript-eslint/eslint-plugin": "^7.16.0",
		"@typescript-eslint/parser": "^7.16.0",
		"esbuild": "^0.21.5",
		"eslint": "^8.57.0",
		"obsidian": "^1.5.7-1",
		"tslib": "^2.6.3",
		"typescript": "^5.5.3"
	}
}
